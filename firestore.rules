rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anti-Abuse Hardware Ledger: prevents re-claiming starter credits
    match /claimed_devices/{deviceId} {
      allow read, write: if true;
    }

    // User Profile & Data by permanent device/user ID
    match /users/{userId} {
      allow read, write: if true;

      // User's Saved Cards
      match /saved_cards/{cardId} {
        allow read, write: if true;
      }

      // User's Birthdays
      match /birthdays/{birthdayId} {
        allow read, write: if true;
      }

      // User's Expenses
      match /expenses/{expenseId} {
        allow read, write: if true;
      }

      // User's Meal Plans
      match /meals/{mealId} {
        allow read, write: if true;
      }
    }
  }
}
